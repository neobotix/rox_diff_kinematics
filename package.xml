<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
   <package format="3">
   <name>rox_diff_kinematics</name>
   <version>1.0.0</version>
   <description>transformation node for neobotix rox robots with differential drive ROS 2</description>
   <author>Pradheep Padmanabhan</author>
   <maintainer email="ros@neobotix.de">Pradheep Padmanabhan</maintainer>
   <license>BSD</license>

   <buildtool_depend>ament_cmake</buildtool_depend>

   <depend>rclcpp</depend>
   <depend>rclcpp_action</depend>
   <depend>rclcpp_lifecycle</depend>
   <depend>std_msgs</depend>
   <depend>geometry_msgs</depend>
   <depend>nav_msgs</depend>
   <depend>sensor_msgs</depend>
   <depend>neo_msgs2</depend>
   <depend>trajectory_msgs</depend>
   <depend>tf2</depend>
   <depend>tf2_ros</depend>
   <depend>tf2_geometry_msgs</depend>

   <export>
     <build_type>ament_cmake</build_type>
   </export>
</package>
